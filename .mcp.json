{
	"mcpServers": {
		"umbraco-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"@umbraco-cms/mcp-dev@latest"
			],
			"env": {
				"NODE_TLS_REJECT_UNAUTHORIZED": "0",
				"UMBRACO_CLIENT_ID": "<API user name>",
				"UMBRACO_CLIENT_SECRET": "<API client secert>",
				"UMBRACO_BASE_URL": "https://<domain>",
				"UMBRACO_INCLUDE_TOOL_COLLECTIONS": "document,media,document-type,data-type,template"
			}
		}
	}
}
